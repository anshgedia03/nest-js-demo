<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rider Lookup</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f6efe6;
        --panel: #fffaf4;
        --ink: #1e1b18;
        --muted: #6d6259;
        --accent: #d9652b;
        --accent-dark: #a9491c;
        --border: #eadac8;
        --error-bg: #fff1ef;
        --error-text: #b13f26;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Georgia, "Times New Roman", serif;
        background:
          radial-gradient(circle at top, rgba(217, 101, 43, 0.16), transparent 38%),
          linear-gradient(180deg, #fcf6ee 0%, var(--bg) 100%);
        color: var(--ink);
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .card {
        width: min(100%, 560px);
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 18px 50px rgba(95, 62, 37, 0.12);
      }

      h1 {
        margin: 0 0 8px;
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 0.95;
      }

      p {
        margin: 0;
        color: var(--muted);
      }

      form {
        margin-top: 28px;
        display: grid;
        gap: 14px;
      }

      label {
        font-size: 0.95rem;
        color: var(--muted);
      }

      input {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 14px 16px;
        font-size: 1rem;
        background: white;
      }

      button {
        border: 0;
        border-radius: 14px;
        padding: 14px 16px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg, var(--accent), var(--accent-dark));
        cursor: pointer;
      }

      .result,
      .error {
        margin-top: 24px;
        border-radius: 18px;
        padding: 18px;
      }

      .result {
        border: 1px solid var(--border);
        background: #fff;
      }

      .error {
        background: var(--error-bg);
        color: var(--error-text);
        border: 1px solid rgba(177, 63, 38, 0.16);
      }

      .label {
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .value {
        margin-top: 6px;
        font-size: 1.2rem;
      }

      .row + .row {
        margin-top: 16px;
      }

      .map-frame {
        margin-top: 18px;
        width: 100%;
        height: 280px;
        border: 1px solid var(--border);
        border-radius: 16px;
      }

      .map-link {
        display: inline-block;
        margin-top: 12px;
        color: var(--accent-dark);
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>Rider Lookup</h1>
      <p>Enter a rider ID to see the rider name and resolved address.</p>

      <form action="/search" method="post">
        <div>
          <label for="riderId">Rider ID</label>
          <input
            id="riderId"
            name="riderId"
            type="number"
            min="1"
            required
            value="<%= riderId %>"
            placeholder="Example: 2"
          />
        </div>
        <button type="submit">Find Rider</button>
      </form>

      <% if (error) { %>
      <section class="error"><%= error %></section>
      <% } %>

      <% if (rider) { %>
      <section class="result">
        <div class="row">
          <div class="label">Rider Name</div>
          <div class="value"><%= rider.name %></div>
        </div>
        <div class="row">
          <div class="label">Address</div>
          <div class="value"><%= rider.address ?? 'Address not available' %></div>
        </div>
        <div class="row">
          <div class="label">Coordinates</div>
          <div class="value"><%= rider.lat %>, <%= rider.lon %></div>
        </div>
        <iframe
          class="map-frame"
          src="<%= rider.mapEmbedUrl %>"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a
          class="map-link"
          href="<%= rider.mapLinkUrl %>"
          target="_blank"
          rel="noreferrer"
        >
          Open map in new tab
        </a>
      </section>
      <% } %>
    </main>
  </body>
</html>
